# Copiar como .env sólo para Docker. No guardar .env en Git.
# El puerto 5081 evita interferir con Visual Studio (5080).
API_PORT=5081

# compose.yaml: sustituir por las credenciales de un usuario SQL autorizado.
# No usar Trusted_Connection=True: Linux no hereda la sesión de Windows.
DB_CONNECTION_STRING=

# compose.demo.yaml: contraseña temporal del SQL Server aislado de demostración.
# Definirla antes de iniciar. Usar 16+ caracteres, mayúsculas, minúsculas y números.
# Evitar ; y comillas porque también se utiliza dentro de la cadena de conexión.
MSSQL_SA_PASSWORD=

# Clave de AutoMapper, si corresponde según los términos del proveedor.
AUTOMAPPER_LICENSE_KEY=
